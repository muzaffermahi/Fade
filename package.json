{
  "name": "fade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "Fade": "dist/cli.js" },
  "description": "Fade: a terminal tool for the mind. Think with a Companion while Pi builds.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "0.73.1",
    "@mariozechner/pi-tui": "0.73.1",
    "@sinclair/typebox": "^0.34.41",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
