{
  "name": "@muzaffermahi/fade",
  "version": "0.5.0",
  "description": "Get your flow back. You navigate, AI drives.",
  "type": "module",
  "bin": {
    "fade": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "demo": "tsx src/cli.ts --demo",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "snapshot": "tsx scripts/snapshot.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-codemode": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-mcp": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "pi-web-access": "0.41.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/assets/demo.gif",
    "docs/final-pass-results.md",
    "docs/hallway-test.md",
    "docs/changelog.md"
  ],
  "license": "MIT"
}
